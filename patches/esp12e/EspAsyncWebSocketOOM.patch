+#ifndef WS_MIN_FREE_HEAP_RESERVE
+  // AMIS: Heap which must be left free after allocating a websocket message buffer
+  #define WS_MIN_FREE_HEAP_RESERVE 2048
+#endif
+
 namespace {
   AsyncWebSocketSharedBuffer makeSharedBuffer(const uint8_t* message, size_t len) {
+#ifdef ESP8266
+    // AMIS: operator new() does not return nullptr on ESP8266 but aborts ("Unhandled C++ exception: OOM")
+    // So check for enough contiguous heap first and discard the message if there is not enough memory
+    if (ESP.getMaxFreeBlockSize() < len + WS_MIN_FREE_HEAP_RESERVE) {
+      ets_printf("AsyncWebSocket: Not enough memory for message (%u bytes): discarding message\n", len);
+      return nullptr;
+    }
+#endif
     auto buffer = std::make_shared<std::vector<uint8_t>>(len);
     std::memcpy(buffer->data(), message, len);
     return buffer;
